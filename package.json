{
  "name": "identity-service",
  "version": "1.0.0",
  "description": "Authentication and authorization service for Marketing Dashboard.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "imports": {
    "#config/*": {
      "source": "./src/config/*.ts",
      "default": "./dist/config/*.js"
    },
    "#db/*": {
      "source": "./src/db/*.ts",
      "default": "./dist/db/*.js"
    },
    "#lib/*": {
      "source": "./src/lib/*.ts",
      "default": "./dist/lib/*.js"
    },
    "#modules/*": {
      "source": "./src/modules/*.ts",
      "default": "./dist/modules/*.js"
    },
    "#observability/*": {
      "source": "./src/observability/*.ts",
      "default": "./dist/observability/*.js"
    },
    "#plugins/*": {
      "source": "./src/plugins/*.ts",
      "default": "./dist/plugins/*.js"
    },
    "#types/*": {
      "source": "./src/types/*.ts",
      "default": "./dist/types/*.js"
    }
  },
  "scripts": {
    "dev": "NODE_ENV=development node --watch --env-file=.env.development --conditions=source src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "NODE_ENV=production node --env-file-if-exists=.env.production dist/server.js",
    "prod": "pnpm run build && pnpm run start",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tools": "tsc -p tsconfig.tools.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed:system": "node --env-file-if-exists=.env.development --conditions=source seed/runners/system.seed.ts",
    "seed:dev": "node --env-file=.env.development --conditions=source seed/runners/dev.seed.ts",
    "openapi:generate": "node --env-file-if-exists=.env.development --conditions=source scripts/generate-openapi.ts",
    "key:generate": "node --env-file-if-exists=.env.development --conditions=source scripts/generate-signing-key.ts",
    "key:rotate": "node --env-file-if-exists=.env.development --conditions=source scripts/rotate-signing-key.ts",
    "verify:rls": "node --env-file-if-exists=.env.development --conditions=source scripts/verify-rls.ts"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.5.3",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.20.0",
    "pnpm": ">=11.5.3"
  },
  "packageManager": "pnpm@11.5.3",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/under-pressure": "^9.1.0",
    "@node-rs/argon2": "^2.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "close-with-grace": "^2.5.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.3",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.8",
    "nodemailer": "^9.0.5",
    "otpauth": "^9.5.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
