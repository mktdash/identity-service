# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development # development | test | production.
PORT=3001
HOST=0.0.0.0

# Carried on every log line as `service`, and reported to OpenTelemetry as `service.name`.
# Lowercase kebab-case. Changing it breaks existing log queries and trace correlation.
SERVICE_NAME=identity-service

# fatal | error | warn | info | debug | trace | silent. `info` in staging/production.
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DATABASE_HOST=
DATABASE_PORT=5433
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_POOL_MAX=10

#  disable      - no TLS. Correct for the local Docker container on the loopback interface.
#  require      - encrypts, but does NOT verify the server certificate — no MITM protection.
#  verify-full  - verifies the certificate chain and hostname. The staging/production target.
DATABASE_SSL=disable

# ---------------------------------------------------------------------------
# PostgreSQL — tooling only, NOT read by the service
# ---------------------------------------------------------------------------
DATABASE_MIGRATION_USER=
DATABASE_MIGRATION_PASSWORD=

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# disable | verify-full.
REDIS_TLS=disable

# ---------------------------------------------------------------------------
# Token signing
# ---------------------------------------------------------------------------
JWT_SIGNING_KEY=
JWT_SIGNING_KEY_ID= # Identifies which signing key was used to sign the JWT.
JWT_ISSUER=https://identity.mktdash.local # Identifies who issued the JWT.
JWT_AUDIENCE=mktdash # Identifies who the JWT is intended for.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
TRUST_PROXY=1
CORS_ALLOWED_ORIGINS=http://localhost:3000
SWAGGER_UI_ENABLED=true
BODY_LIMIT_BYTES=65536
REQUEST_TIMEOUT_MS=15000

WEB_APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Outbound mail
# ---------------------------------------------------------------------------
MAIL_TRANSPORT=smtp
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Marketing Dashboard
MAIL_REPLY_TO_ADDRESS=

# ---------------------------------------------------------------------------
# SMTP relay — provider-independent
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Docker Compose — local containers only, NOT read by the service
# ---------------------------------------------------------------------------
DOCKER_POSTGRES_BIND_HOST=127.0.0.1
DOCKER_REDIS_BIND_HOST=127.0.0.1
